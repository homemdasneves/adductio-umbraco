  <Properties>
    <metaDescription>
      <Value Culture="en-us"><![CDATA[Extensive experience in the preparation of studies and projects applied to the review of work carried out by third parties .]]></Value>
      <Value Culture="pt-pt"><![CDATA[A vasta experiência na elaboração de estudos e projetos aplicada à revisão de trabalhos realizados por terceiros.
]]></Value>
