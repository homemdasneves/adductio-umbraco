@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage;

@{
	Layout = "Master.cshtml";
}
<section class="mt-14">
	<div class="container">
		<h1 class="text-adductioBlue text-4xl font-bold">@Model.Name</h1>
		<div class="mb-4 mt-4">
			<div class="w-[10%] h-1 bg-adductioOrange"></div>
		</div>
	</div>
</section>
@await Html.PartialAsync("global/Who", Model, new ViewDataDictionary(ViewData) { { "className", "pb-10" } })
@await Html.PartialAsync("global/ContactForm")